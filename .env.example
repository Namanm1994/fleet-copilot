# Copy to .env and fill in the key for the provider you use. Never commit .env.
# Provider: anthropic | openai | openrouter
FLEET_LLM_PROVIDER=anthropic
# Model ID as the provider names it (pinned; see config/llm.yaml for the default)
FLEET_LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
