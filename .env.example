# Copy to .env and fill in the key for the provider you use. Never commit .env.
# Provider: anthropic | openai | openrouter. Leave both lines empty to use the defaults in
# config/llm.yaml (OpenRouter and the model pinned there).
FLEET_LLM_PROVIDER=
# Model ID as the provider names it
FLEET_LLM_MODEL=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
